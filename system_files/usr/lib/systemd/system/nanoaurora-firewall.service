[Unit]
Description=Keep the NanoAurora agent off the local network
Documentation=file:///usr/share/nanobot-os/README.md
After=firewalld.service
# user@.service starts after systemd-user-sessions, so the rules are in place
# before the agent's lingering user services can run.
Before=systemd-user-sessions.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/nanoaurora-firewall

[Install]
WantedBy=multi-user.target
