#!/usr/bin/bash
# Moves a system set up under an earlier name (nanobot OS, NanoAurora) onto NanoBorealis's
# names, so an update never strands a working agent. Runs at every boot; each step only acts
# when it finds the old layout, so it's a no-op on fresh installs and after the first run.
set -uo pipefail

AGENT_USER=nanobot-agent
did=0
log() { echo "nanoborealis-migrate: $*"; did=1; }

# The shared projects folder. mv keeps its ACLs and SELinux labels.
if [ -d /srv/nanoaurora ] && [ ! -e /srv/nanoborealis ]; then
    mv /srv/nanoaurora /srv/nanoborealis && log "moved /srv/nanoaurora to /srv/nanoborealis"
fi

# Each user's shortcut to it, and the desktop update icon.
for home in /var/home/*; do
    [ -d "$home" ] || continue
    owner="$(stat -c %U "$home")"
    if [ -L "$home/nanoaurora-projects" ]; then
        rm -f "$home/nanoaurora-projects"
        ln -sfn /srv/nanoborealis/projects "$home/nanoborealis-projects"
        chown -h "$owner:" "$home/nanoborealis-projects"
        log "relinked projects for $owner"
    fi
    for desktop in "$home/Desktop" "$home/Schreibtisch" "$home/Bureau"; do
        if [ -f "$desktop/nanoaurora-update.desktop" ]; then
            install -o "$owner" -g "$(stat -c %G "$home")" -m 0755 \
                /usr/share/applications/nanoborealis-update.desktop "$desktop/nanoborealis-update.desktop"
            rm -f "$desktop/nanoaurora-update.desktop"
            log "replaced the update icon on $owner's desktop"
        fi
    done
done

# The clock. Installs from installers before September 25, 2026 read the hardware clock as local
# time and have network time off, so the clock runs hours off (and this computer's TLS
# certificate looked "not yet valid" to others). Fix that once: read the hardware clock as UTC,
# set the system clock from it, and turn on network time. The marker leaves any later choice alone.
clock_marker=/var/lib/nanoborealis/clock-fixed
if [ ! -e "$clock_marker" ]; then
    if grep -qx LOCAL /etc/adjtime 2>/dev/null; then
        timedatectl set-local-rtc 0 --adjust-system-clock && log "the hardware clock is read as UTC now"
    fi
    if ! systemctl is-enabled --quiet chronyd.service 2>/dev/null; then
        systemctl enable --now chronyd.service && log "turned network time on (chronyd)"
    fi
    mkdir -p /var/lib/nanoborealis && touch "$clock_marker"
fi

# The agent's hidden "default" model. nanobot always offers a model preset named "default", made
# from agents.defaults.model, and that is Claude Opus, which is billed, unless the config says
# otherwise; configs from before September 25, 2026 didn't. Point it at the free Nemotron Ultra,
# once, as the agent's own account, and only if no default model was ever chosen.
model_marker=/var/lib/nanoborealis/free-default-model
if [ ! -e "$model_marker" ] && agent_home="$(getent passwd "$AGENT_USER" | cut -d: -f6)" && [ -n "$agent_home" ]; then
    config="$agent_home/.local/share/containers/storage/volumes/nanobot-home/_data/.nanobot/config.json"
    if runuser -u "$AGENT_USER" -- test -f "$config"; then
        if runuser -u "$AGENT_USER" -- python3 - "$config" <<'EOF'
import json, os, sys
path = sys.argv[1]
with open(path, encoding="utf-8") as f:
    config = json.load(f)
defaults = config.setdefault("agents", {}).setdefault("defaults", {})
if defaults.get("model"):
    sys.exit(1)  # chosen already: leave it alone
defaults["model"] = "nvidia/nemotron-3-ultra-550b-a55b:free"
defaults["provider"] = "openrouter"
temporary = path + ".nanoborealis-tmp"
with open(temporary, "w", encoding="utf-8") as f:
    f.write(json.dumps(config, indent=2) + "\n")
os.chmod(temporary, os.stat(path).st_mode & 0o777)
os.replace(temporary, path)
EOF
        then
            log "the agent's default model is the free Nemotron Ultra now (it was a billed one)"
        fi
        mkdir -p /var/lib/nanoborealis && touch "$model_marker"
    fi
fi

# Devices approved for compute sharing.
if [ -d /etc/nanoaurora ] && [ ! -e /etc/nanoborealis ]; then
    mv /etc/nanoaurora /etc/nanoborealis && log "moved /etc/nanoaurora to /etc/nanoborealis"
fi

# The agent: its build context, its Quadlet unit, and its local image name.
if agent_home="$(getent passwd "$AGENT_USER" | cut -d: -f6)" && [ -n "$agent_home" ]; then
    if [ -d "$agent_home/nanobot-os" ] && [ ! -e "$agent_home/nanoborealis" ]; then
        mv "$agent_home/nanobot-os" "$agent_home/nanoborealis" && log "moved the agent's build folder"
    fi
    quadlet="$agent_home/.config/containers/systemd/nanobot.container"
    if [ -f "$quadlet" ] && grep -q -e '/srv/nanoaurora/' -e 'localhost/nanobot-os:' "$quadlet"; then
        uid="$(id -u "$AGENT_USER")"
        # Rootless Podman needs the agent's runtime directory; logind makes it for lingering users.
        for _ in $(seq 1 60); do [ -S "/run/user/$uid/bus" ] && break; sleep 1; done
        as_agent() {
            runuser -u "$AGENT_USER" -- env HOME="$agent_home" XDG_RUNTIME_DIR="/run/user/$uid" \
                DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" "$@"
        }
        if as_agent podman image exists localhost/nanobot-os:latest; then
            as_agent podman tag localhost/nanobot-os:latest localhost/nanoborealis-agent:latest
        fi
        sed -i -e 's|/srv/nanoaurora/|/srv/nanoborealis/|g' \
               -e 's|localhost/nanobot-os:latest|localhost/nanoborealis-agent:latest|' \
               -e 's|^Description=.*|Description=NanoBorealis agent (nanobot gateway + WebUI)|' "$quadlet"
        log "updated the agent's Quadlet unit"
        if [ -S "/run/user/$uid/bus" ]; then
            as_agent systemctl --user daemon-reload
            as_agent systemctl --user restart nanobot.service || true
        fi
    fi
fi

[ "$did" -eq 1 ] || echo "nanoborealis-migrate: nothing to migrate"
exit 0
